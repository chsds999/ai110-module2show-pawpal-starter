classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferred_categories
        +list~Pet~ pets
        +add_pet(pet)
        +update_available_time(minutes)
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task)
        +remove_task(task)
        +complete_task(task) Task
    }

    class Task {
        +str name
        +str category
        +int duration_minutes
        +int priority
        +bool completed
        +str description
        +str frequency
        +date due_date
        +str scheduled_time
        +update_details(duration_minutes, priority)
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled_tasks
        +list~str~ explanations
        +generate_plan() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +detect_conflicts() list~str~
        +explain_plan() list~str~
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Pet ..> Task : creates next occurrence
    Scheduler --> "1" Owner : uses
    Scheduler --> "0..*" Task : selects

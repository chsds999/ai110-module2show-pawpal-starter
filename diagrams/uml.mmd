classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferred_categories
        +list~Pet~ pets
        +add_pet(pet)
        +update_available_time(minutes)
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Task {
        +str name
        +str category
        +int duration_minutes
        +int priority
        +bool completed
        +update_details(duration_minutes, priority)
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled_tasks
        +list~str~ explanations
        +generate_plan()
        +explain_plan()
    }

